{
  "name": "envsec-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "clean": "turbo run clean",
    "check": "ultracite check --disable-nested-config",
    "fix": "ultracite fix --disable-nested-config",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.9.1",
    "typescript": "^5.9.3",
    "ultracite": "7.12.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.0",
      "effect": "4.0.0"
    }
  }
}
