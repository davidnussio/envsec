  "dependencies": {
    "@envsec/core": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
