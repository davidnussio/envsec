{
  "name": "envsec",
  "version": "1.1.0",
  "description": "Secure environment secrets management using native OS credential stores",
  "keywords": [
    "cli",
    "credential-manager",
    "cross-platform",
    "effect",
    "environment-variables",
    "keychain",
    "libsecret",
    "linux",
    "macos",
    "secrets",
    "windows"
  ],
  "homepage": "https://envsec.dev",
  "bugs": {
    "url": "https://github.com/davidnussio/envsec/issues"
  },
  "license": "MIT",
  "author": "David Nussio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidnussio/envsec.git",
    "directory": "packages/cli"
  },
  "bin": {
    "envsec": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:bin": "bun scripts/build-bin.ts",
    "prepublishOnly": "npm run build",
    "test": "bash test/e2e-test.sh",
    "test:unit": "pnpm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0",
    "@envsec/core": "workspace:*",
    "@envsec/tui": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
